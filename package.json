{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.3.1",
  "engines": {
    "node": "^20",
    "npm": "^10"
  },
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next",
    "dev": "NODE_OPTIONS='--inspect --trace-warnings' next dev",
    "eslint:check": "eslint .",
    "eslint:write": "eslint . --fix",
    "lint:check": "next lint",
    "lint:write": "next lint --fix",
    "postbuild": "next-sitemap",
    "prepare": "husky install",
    "prettier:check": "prettier . --check --ignore-path .prettierignore",
    "prettier:write": "prettier . --write --ignore-path .prettierignore",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.13.0",
    "@googlemaps/react-wrapper": "^1.1.35",
    "@googlemaps/typescript-guards": "^2.0.3",
    "@mantine/core": "^6.0.22",
    "@mantine/form": "^6.0.22",
    "@mantine/hooks": "^6.0.22",
    "@mantine/next": "^6.0.22",
    "@mantine/notifications": "^6.0.22",
    "@tabler/icons-react": "^3.11.0",
    "fast-equals": "^5.0.1",
    "next": "^14.2.5",
    "next-pwa": "^5.6.0",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@next/bundle-analyzer": "^14.2.5",
    "@next/env": "^14.2.5",
    "@types/google.maps": "^3.55.11",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-typescript-sort-keys": "^3.2.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "react-type-animation": "^3.2.0",
    "typescript": "^5.5.3",
    "webpack": "^5"
  },
  "lint-staged": {
    "**/*.{cjs,js,jsx,mjs,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{cjs,html,js,jsx,json,md,mjs,scss,ts,tsx}": [
      "prettier --ignore-path .prettierignore --write"
    ]
  },
  "sideEffects": false
}
