{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.8.1",
  "engines": {
    "node": "24.x",
    "npm": "^10"
  },
  "scripts": {
    "build": "next build && next-sitemap",
    "clean": "rm -rf .next",
    "css-vars:check": "node scripts/generate-mantine-css-variables.mjs --check",
    "css-vars:generate": "node scripts/generate-mantine-css-variables.mjs",
    "dev": "NODE_OPTIONS='--inspect --trace-warnings' next dev",
    "eslint:check": "eslint .",
    "eslint:write": "eslint . --fix",
    "lint:check": "next lint",
    "lint:write": "next lint --fix",
    "postinstall": "yarn css-vars:generate",
    "prepare": "husky install",
    "prettier:check": "prettier . --check --ignore-path .prettierignore",
    "prettier:write": "prettier . --write --ignore-path .prettierignore",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@googlemaps/react-wrapper": "^1.2.0",
    "@googlemaps/typescript-guards": "^2.0.3",
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@serwist/next": "^9.5.12",
    "@tabler/icons-react": "^3.46.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "fast-equals": "^5.4.1",
    "next": "^15.5.23",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@next/bundle-analyzer": "^15.5.23",
    "@next/env": "^15.5.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/google.maps": "^3.65.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^16.4.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.26",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.2",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react-type-animation": "^3.2.0",
    "serwist": "^9.5.12",
    "typescript": "^5.9.3",
    "webpack": "^5"
  },
  "lint-staged": {
    "**/*.{cjs,js,jsx,mjs,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{cjs,html,js,jsx,json,md,mjs,scss,ts,tsx}": [
      "prettier --ignore-path .prettierignore --write"
    ]
  },
  "sideEffects": false
}
