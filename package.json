{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@3.6.2",
  "engines": {
    "node": "^18",
    "npm": "^9"
  },
  "scripts": {
    "build": "yarn write:last-modified && next build",
    "clean": "rm -rf .next",
    "dev": "NODE_OPTIONS='--inspect --trace-warnings' next dev",
    "eslint:check": "eslint .",
    "eslint:write": "eslint . --fix",
    "lint:check": "next lint",
    "lint:write": "next lint --fix",
    "postbuild": "next-sitemap",
    "postinstall": "yarn write:last-modified",
    "prepare": "husky install",
    "prettier:check": "prettier . --check --ignore-path .prettierignore",
    "prettier:write": "prettier . --write --ignore-path .prettierignore",
    "start": "next start",
    "write:last-modified": "node tools/build-time-config",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@googlemaps/react-wrapper": "^1.1.35",
    "@googlemaps/typescript-guards": "^2.0.3",
    "@mantine/core": "^6.0.19",
    "@mantine/form": "^6.0.19",
    "@mantine/hooks": "^6.0.19",
    "@mantine/next": "^6.0.19",
    "@mantine/notifications": "^6.0.19",
    "@tabler/icons-react": "^2.32.0",
    "date-fns": "^2.30.0",
    "fast-equals": "^5.0.1",
    "next": "^13.4.19",
    "next-pwa": "^5.6.0",
    "nodemailer": "^6.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.32.5",
    "swr": "^2.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@next/bundle-analyzer": "^13.4.19",
    "@next/env": "^13.4.19",
    "@types/google.maps": "^3.53.6",
    "@types/node": "^20.5.2",
    "@types/nodemailer": "^6.4.9",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "eslint-config-next": "^13.4.19",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sort-destructure-keys": "^1.5.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-typescript-sort-keys": "^2.3.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^8.0.3",
    "jsonfile": "^6.1.0",
    "lint-staged": "^14.0.1",
    "next-sitemap": "^4.2.2",
    "prettier": "^3.0.2",
    "prop-types": "^15.8.1",
    "react-type-animation": "^3.1.0",
    "typescript": "^5.1.6",
    "webpack": "^5"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs}": [
      "eslint --fix"
    ],
    "**/*.{ts,tsx,cjs,js,jsx,json,html,scss,md}": [
      "prettier --ignore-path .prettierignore --write"
    ]
  },
  "sideEffects": false
}
