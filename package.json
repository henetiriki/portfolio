{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "yarn write:last-modified && next build",
    "clean": "rm -rf .next",
    "dev": "NODE_OPTIONS='--inspect --trace-warnings' next dev",
    "eslint:check": "eslint .",
    "eslint:write": "eslint . --fix",
    "lint:check": "next lint",
    "lint:write": "next lint --fix",
    "postbuild": "next-sitemap",
    "postinstall": "yarn write:last-modified",
    "prepare": "husky install",
    "prettier:check": "prettier . --check --ignore-path .prettierignore",
    "prettier:write": "prettier . --write --ignore-path .prettierignore",
    "start": "next start",
    "write:last-modified": "node tools/build-time-config"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-brands-svg-icons": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@googlemaps/react-wrapper": "^1.1.35",
    "@googlemaps/typescript-guards": "^2.0.3",
    "@nextui-org/react": "^1.0.0-beta.10",
    "date-fns": "^2.29.3",
    "fast-equals": "^4.0.3",
    "formik": "^2.2.9",
    "next": "^12.3.1",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.2.1",
    "nodemailer": "^6.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^9.0.8",
    "sharp": "^0.31.1",
    "swr": "^1.3.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@next/bundle-analyzer": "^12.3.1",
    "@next/env": "^12.3.1",
    "@types/google.maps": "^3.50.4",
    "@types/node": "^18.8.5",
    "@types/nodemailer": "^6.4.6",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "eslint": "^8.25.0",
    "eslint-config-next": "^12.3.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.5.0",
    "eslint-plugin-sort-destructure-keys": "^1.4.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-typescript-sort-keys": "^2.1.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^8.0.1",
    "jsonfile": "^6.1.0",
    "lint-staged": "^13.0.3",
    "next-sitemap": "^3.1.24",
    "prettier": "^2.7.1",
    "prop-types": "^15.8.1",
    "react-type-animation": "^2.1.1",
    "sass": "^1.55.0",
    "typescript": "^4.8.4",
    "webpack": "^5"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "**/*.{ts,tsx,js,jsx,json,html,scss,md}": [
      "prettier --ignore-path .prettierignore --write"
    ]
  },
  "sideEffects": false
}
