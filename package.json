{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build --webpack && next-sitemap",
    "clean": "rm -rf .next",
    "css-vars:check": "node scripts/generate-mantine-css-variables.mjs --check",
    "css-vars:generate": "node scripts/generate-mantine-css-variables.mjs",
    "dev": "NODE_OPTIONS='--inspect --trace-warnings' next dev",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "eslint:check": "eslint .",
    "eslint:write": "eslint . --fix",
    "icons:check": "node scripts/generate-pwa-icons.mjs --check",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "postinstall": "yarn css-vars:generate",
    "prepare": "husky install",
    "prettier:check": "prettier . --check --ignore-path .prettierignore",
    "prettier:write": "prettier . --write --ignore-path .prettierignore",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "jest --watch",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@mantine/core": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@serwist/next": "^9.5.12",
    "@tabler/icons-react": "^3.46.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "next": "^16.3.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7",
    "@next/bundle-analyzer": "^16.3.1",
    "@next/env": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/google.maps": "^3.65.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "next-sitemap": "^4.2.3",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.2",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react-type-animation": "^3.2.0",
    "serwist": "^9.5.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5"
  },
  "lint-staged": {
    "**/*.{cjs,js,jsx,mjs,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{cjs,html,js,jsx,json,md,mjs,scss,ts,tsx}": [
      "prettier --ignore-path .prettierignore --write"
    ]
  },
  "dependenciesMeta": {
    "unrs-resolver": {
      "built": true
    }
  }
}
