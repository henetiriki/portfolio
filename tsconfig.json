{
  "compilerOptions": {
    "target": "es2015",
    "baseUrl": ".",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@components/*": ["components/*"],
      "@containers/*": ["containers/*"],
      "@fixtures/*": ["fixtures/*"],
      "@hooks": ["hooks"],
      "@pages/*": ["pages/*"],
      "@server/*": ["src/server/*"],
      "@state/*": ["src/state/*"],
      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true
  },
  "include": [
    "emotion.d.ts",
    "next-env.d.ts",
    "mantine-custom-colors.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
