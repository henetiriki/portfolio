# Non-secret dummy values so next.config.js validates while running Jest (NODE_ENV=test).
# Next.js loads .env.test instead of .env.local under `test` — see docs/environment-variables.md.
PROTOCOL=https
HOSTNAME=localhost:3000
HOST=http://localhost:3000
IMAGE_HOST=http://localhost:3000/images
IMAGE_HOST_NAME=localhost
IMAGE_HOST_PATH=images
IMAGE_HOST_PROTOCOL=http
GOOGLE_MAPS_API_KEY=test-google-maps-api-key
GOOGLE_MAPS_MAP_ID=test-google-maps-map-id
ISTAGRAM_IMAGE_IDS=BZ4QGdOn6SP,Bcg0AZwFwv6,B5zAuLqJTEg,CEbEP7XJafW
CUSTOM_APP_DOMAIN=example.test
GMAIL_SENDER_EMAIL=owner@example.test
GMAIL_APP_EMAIL=owner@example.test
GMAIL_APP_PASSWORD=test-app-password
# Off, as it is everywhere but a deliberate monitoring window; the tests that
# cover the enabled path set it themselves. See docs/security.md.
CSP_VIOLATION_EMAILS=false

# NEXT_PUBLIC_* mirrors of the above: next.config.js's `env` key re-exposes
# these under NEXT_PUBLIC_* names for the real Next.js runtime (see the `env`
# block in next.config.js), but next/jest doesn't evaluate that config key —
# it only loads .env files directly — so the same dummy values are repeated
# here under their NEXT_PUBLIC_* names for tests to read.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_HOST=http://localhost:3000/images
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=test-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=test-google-maps-map-id
NEXT_PUBLIC_LAST_MODIFIED=test
